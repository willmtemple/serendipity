{
  "name": "@serendipity/editor-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "start": "pnpm run dev",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@serendipity/camino": "workspace:*",
    "@serendipity/compiler-desugar": "workspace:*",
    "@serendipity/editor-stores": "workspace:*",
    "@serendipity/interpreter": "workspace:*",
    "@serendipity/parser": "workspace:*",
    "@serendipity/syntax": "workspace:*",
    "@serendipity/syntax-surface": "workspace:*",
    "@babel/plugin-syntax-flow": "^7.17.12",
    "@babel/plugin-transform-react-jsx": "^7.17.12",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sass": "^1.99.0",
    "xterm": "^3.14.5",
    "@babel/core": "^7.13.0",
    "react-router-dom": "^7.15.0",
    "@monaco-editor/react": "^4.7.0",
    "monaco-editor": "^0.33.0",
    "mobx-react": "^9.2.1",
    "mobx": "^6.15.0",
    "react-json-tree": "^0.20.0",
    "ansi-colors": "~4.1.1",
    "omnimatch": "1.0.0-development.2"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vitest": "^4.1.5"
  }
}

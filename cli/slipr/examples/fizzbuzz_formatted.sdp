// This is a simple implementation of FizzBuzz demonstrating basic procedural
// programming.

import { range } = use("./utils/iteration.sdp");

main #[
  // Ranges are iterable integer intervals that are inclusive of the first value
  // but exclusive of the second value.

  for i in range(1, 46) do #[
    if i % 3 == 0 && i % 5 == 0 then print("FizzBuzz")
    else if i % 3 == 0 /* sneaky comment :) */
    then print("Fizz")
    else if i % 5 == 0 then print("Buzz")
    else print(i);
  ];
];

